{
  "name": "@flowforge/renderer",
  "version": "0.1.0",
  "description": "Themed, sanitised SVG rendering of a laid-out FlowForge diagram.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flowforge/core": "workspace:*",
    "@flowforge/layout": "workspace:*"
  },
  "devDependencies": {
    "@flowforge/parser": "workspace:*",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "@types/jsdom": "^30.0.0"
  }
}
