{
  "name": "@flowforge/providers",
  "version": "0.1.0",
  "description": "Cloud service registry and cautious service recognition for FlowForge. Contains no provider icons (ADR-0007).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flowforge/core": "workspace:*",
    "@flowforge/transforms": "workspace:*"
  }
}
